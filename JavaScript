/* ==========================================================================
   كود JavaScript المنقح - معرض الصعيدي للأدوات الصحية (script.js)
   ========================================================================== */

document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.querySelector('.navbar');
    const navLinks = document.querySelectorAll('.navbar-links a');

    // التنقل السلس للروابط الداخلية مع تعويض ارتفاع الشريط العلوي
    navLinks.forEach(link => {
        link.addEventListener('click', function (e) {
            const href = this.getAttribute('href');

            // التنفيذ فقط للروابط الداخلية التي تبدأ بـ #
            if (href && href.startsWith('#') && href.length > 1) {
                const targetElement = document.querySelector(href);
                if (targetElement) {
                    e.preventDefault();
                    const navbarHeight = navbar ? navbar.offsetHeight : 70;
                    const targetPosition = targetElement.getBoundingClientRect().top + window.scrollY - navbarHeight - 10;

                    window.scrollTo({
                        top: Math.max(0, targetPosition),
                        behavior: 'smooth'
                    });

                    // تحديث الرابط في المتصفح بدون إعادة تحميل
                    history.pushState(null, null, href);
                }
            }
        });
    });

    // تمييز الرابط النشط في القائمة حسب موقع التمرير الحالي
    const trackedIds = ['home', 'plumber', 'calculator', 'about'];

    function updateActiveLink() {
        const navbarHeight = navbar ? navbar.offsetHeight : 70;
        const scrollPosition = window.scrollY + navbarHeight + 60;
        let currentId = 'home';

        trackedIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                const top = el.getBoundingClientRect().top + window.scrollY;
                if (scrollPosition >= top) {
                    currentId = id;
                }
            }
        });

        navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === `#${currentId}`) {
                link.classList.add('active');
            } else {
                link.classList.remove('active');
            }
        });
    }

    window.addEventListener('scroll', updateActiveLink, { passive: true });
    updateActiveLink();
});
