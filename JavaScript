/* ==========================================================================
   تطوير وتحديث كود JavaScript - معرض الصعيدي للأدوات الصحية
   ========================================================================== */

document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('.section, .overlay');
    const allLinks = document.querySelectorAll('.navbar-links a');

    // دالة مرنة لتبديل الأقسام بسلاسة تامة دون إجهاد المعالج
    function switchSection(targetId) {
        if (!targetId || targetId.startsWith('http')) return false;

        // تأثير اختفاء تدريجي سريع ومريح للعين
        document.body.style.opacity = '0.85';
        
        setTimeout(() => {
            sections.forEach(sec => {
                if (sec.id === targetId) {
                    // تشغيل القسم المطلوب بناءً على نوعه
                    sec.style.display = (targetId === 'home') ? 'flex' : 'block';
                    sec.style.animation = 'fadeInSection 0.4s ease-out forwards';
                } else {
                    sec.style.display = 'none';
                    sec.style.animation = 'none';
                }
            });
            
            document.body.style.opacity = '1';
            // صعود انسيابي لأعلى الصفحة الجديدة
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }, 80);

        return true;
    }

    // استماع لجميع ضغطات أزرار القائمة العلوية
    allLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            const href = this.getAttribute('href');
            
            // التأكد أن الرابط داخلي (يبدأ بـ #) وليس رابطاً خارجياً كالواتساب أو الخريطة
            if (href && href.startsWith('#')) {
                const targetId = href.substring(1);
                if (switchSection(targetId)) {
                    e.preventDefault();
                    // تحديث رابط المتصفح العلوي بدون إعادة تحميل
                    history.pushState(null, null, href);
                }
            }
        });
    });

    // دعم زرار الرجوع (Back) في الموبايل ليتنقل بين الأقسام بدلاً من الخروج من الموقع
    window.addEventListener('popstate', () => {
        const currentHash = window.location.hash ? window.location.hash.substring(1) : 'home';
        switchSection(currentHash);
    });

    // تشغيل الصفحة الافتتاحية (الرئيسية) فور انتهاء التحميل
    sections.forEach(sec => {
        sec.style.display = (sec.id === 'home') ? 'flex' : 'none';
    });
});
